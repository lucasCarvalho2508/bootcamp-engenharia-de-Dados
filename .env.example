# Copy this file to .env and replace every placeholder before starting Compose.
POSTGRES_DB=novadrive
POSTGRES_USER=etlreadonly
POSTGRES_PASSWORD=replace-with-48-character-hex-secret

# Keep the same database/user/password as above. URL-encode reserved characters.
AIRFLOW_DATABASE_URL=postgresql+psycopg2://etlreadonly:URL_ENCODED_PASSWORD@postgres:5432/novadrive

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-another-48-character-hex-secret

# Generate with: docker run --rm apache/airflow:2.7.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace-with-a-valid-fernet-key
